@model List<Student>

@{
    ViewData["Title"] = "Home Page";
}


<div class="text-center">
    <h1 class="display-4">Welcome to students portal </h1>
   
</div>
<div>
    <table border="1" cellpadding="10">
        <tr>
            <th>ID</th>
            <th>NAME</th>
            <th>AGE</th>
            <th>COURSE</th>
            <th>Gender</th>
            <th>Qualification</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Age</td>
                <td>@item.Course</td>
                <td>@item.Gender</td>
                <td>@item.Qualification</td>
            </tr>
        }
    </table>
</div>

   